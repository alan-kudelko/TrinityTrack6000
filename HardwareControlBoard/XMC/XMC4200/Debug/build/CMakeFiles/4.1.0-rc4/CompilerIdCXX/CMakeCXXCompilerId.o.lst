 446:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp **** /* Construct the string literal in pieces to prevent the source from
 447:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp ****    getting matched.  Store it in a pointer rather than an array
 448:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp ****    because some compilers will just produce instructions to fill the
 449:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp ****    array rather than assigning a pointer to a static array.  */
 450:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp **** char const* info_compiler = "INFO" ":" "compiler[" COMPILER_ID "]";
 451:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp **** #ifdef SIMULATE_ID
 452:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp **** char const* info_simulate = "INFO" ":" "simulate[" SIMULATE_ID "]";
 453:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp **** #endif
 454:../build/CMakeFiles/4.1.0-rc4/CompilerIdCXX/CMakeCXXCompilerId.cpp **** 
