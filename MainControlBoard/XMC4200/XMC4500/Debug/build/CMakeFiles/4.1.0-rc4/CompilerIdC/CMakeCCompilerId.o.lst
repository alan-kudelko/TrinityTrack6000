 851:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** /* Construct the string literal in pieces to prevent the source from
 852:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****    getting matched.  Store it in a pointer rather than an array
 853:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****    because some compilers will just produce instructions to fill the
 854:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****    array rather than assigning a pointer to a static array.  */
 855:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** char const* info_platform = "INFO" ":" "platform[" PLATFORM_ID "]";
