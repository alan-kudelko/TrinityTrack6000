 778:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** /* Convert integer to decimal digit literals.  */
 779:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #define DEC(n)                   \
 780:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + (((n) / 10000000)%10)), \
 781:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + (((n) / 1000000)%10)),  \
 782:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + (((n) / 100000)%10)),   \
 783:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + (((n) / 10000)%10)),    \
 784:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + (((n) / 1000)%10)),     \
 785:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + (((n) / 100)%10)),      \
 786:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + (((n) / 10)%10)),       \
 787:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' +  ((n) % 10))
 788:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** 
 789:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** /* Convert integer to hex digit literals.  */
 790:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #define HEX(n)             \
 791:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)>>28 & 0xF)), \
 792:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)>>24 & 0xF)), \
 793:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)>>20 & 0xF)), \
 794:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)>>16 & 0xF)), \
 795:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)>>12 & 0xF)), \
 796:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)>>8  & 0xF)), \
 797:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)>>4  & 0xF)), \
 798:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****   ('0' + ((n)     & 0xF))
