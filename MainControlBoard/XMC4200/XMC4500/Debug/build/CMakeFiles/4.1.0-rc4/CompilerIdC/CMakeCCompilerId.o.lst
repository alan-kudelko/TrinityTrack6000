  44:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #  define COMPILER_VERSION_MINOR DEC(__INTEL_COMPILER_UPDATE)
  45:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****    /* The third version component from --version is an update index,
  46:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****       but no macro is provided for it.  */
  47:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #  define COMPILER_VERSION_PATCH DEC(0)
  48:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** # endif
  49:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** # if defined(__INTEL_COMPILER_BUILD_DATE)
