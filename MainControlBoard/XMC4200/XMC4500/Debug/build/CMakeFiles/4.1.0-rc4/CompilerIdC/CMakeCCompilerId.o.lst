 467:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** /* Construct the string literal in pieces to prevent the source from
 468:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****    getting matched.  Store it in a pointer rather than an array
 469:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****    because some compilers will just produce instructions to fill the
 470:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c ****    array rather than assigning a pointer to a static array.  */
 471:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** char const* info_compiler = "INFO" ":" "compiler[" COMPILER_ID "]";
 472:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #ifdef SIMULATE_ID
 473:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** char const* info_simulate = "INFO" ":" "simulate[" SIMULATE_ID "]";
 474:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #endif
 475:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** 
