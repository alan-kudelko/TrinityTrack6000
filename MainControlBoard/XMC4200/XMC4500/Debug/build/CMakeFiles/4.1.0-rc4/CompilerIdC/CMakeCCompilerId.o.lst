 477:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** char const* qnxnto = "INFO" ":" "qnxnto[]";
 478:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #endif
 479:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** 
 480:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #if defined(__CRAYXT_COMPUTE_LINUX_TARGET)
 481:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** char const *info_cray = "INFO" ":" "compiler_wrapper[CrayPrgEnv]";
 482:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** #endif
 483:../build/CMakeFiles/4.1.0-rc4/CompilerIdC/CMakeCCompilerId.c **** 
