  73              	/* ===========START : MACRO DEFINITION MACRO DEFINITION ================== */
  74              	 
  75              	.macro Entry Handler
  76              	#if defined(ENABLE_PMU_CM_001_WORKAROUND)
  77              	    .long \Handler\()_Veneer
  78              	#else
  79              	    .long \Handler
  80              	#endif
  81              	.endm
  82              	
  83              	.macro Insert_ExceptionHandler Handler_Func 
  84              	    .weak \Handler_Func
  85              	#if defined(ENABLE_OWN_HANDLER)
  86              	    .thumb_func
  88              	\Handler_Func:
  89              	    b .
  91              	#else
  92              	    .thumb_set \Handler_Func, Default_Handler
  93              	#endif 
  94              	
  95              	#if defined(ENABLE_PMU_CM_001_WORKAROUND)  
  96              	    .weak \Handler_Func\()_Veneer
  98              	\Handler_Func\()_Veneer:
  99              	    push {r0, lr}
 100              	    ldr  r0, =\Handler_Func
 101              	    blx  r0
 102              	    pop  {r0, pc}
 104              	#endif 
 105              	.endm
