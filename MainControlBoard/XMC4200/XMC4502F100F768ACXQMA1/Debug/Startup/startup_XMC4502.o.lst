 271              	/* Initialize data
 272              	 *
 273              	 *  Between symbol address __copy_table_start__ and __copy_table_end__,
 274              	 *  there are array of triplets, each of which specify:
 275              	 *    offset 0: LMA of start of a section to copy from
 276              	 *    offset 4: VMA of start of a section to copy to
 277              	 *    offset 8: size of the section to copy. Must be multiply of 4
 278              	 *
 279              	 *  All addresses must be aligned to 4 bytes boundary.
 280              	 */
 281 0208 234C     		ldr	r4, =__copy_table_start__
 282 020a 244D     		ldr	r5, =__copy_table_end__
 283              	
 284              	.L_loop0:
 285 020c AC42     		cmp	r4, r5
 286 020e 09DA     		bge	.L_loop0_done
 287 0210 2168     		ldr	r1, [r4]
 288 0212 6268     		ldr	r2, [r4, #4]
 289 0214 A368     		ldr	r3, [r4, #8]
 290              	
 291              	.L_loop0_0:
 292 0216 043B     		subs	r3, #4
 293 0218 A2BF     		ittt	ge
 294 021a C858     		ldrge	r0, [r1, r3]
 295 021c D050     		strge	r0, [r2, r3]
 296 021e FAE7     		bge	.L_loop0_0
 297              	
 298 0220 0C34     		adds	r4, #12
 299 0222 F3E7     		b	.L_loop0
 300              	
 301              	.L_loop0_done:
 302              	
 303              	/* Zero initialized data 
 304              	 *  Between symbol address __zero_table_start__ and __zero_table_end__,
 305              	 *  there are array of tuples specifying:
 306              	 *    offset 0: Start of a BSS section
 307              	 *    offset 4: Size of this BSS section. Must be multiply of 4
 308              	 *
 309              	 *  Define __SKIP_BSS_CLEAR to disable zeroing uninitialzed data in startup.
 310              	 */    
 311              	#ifndef __SKIP_BSS_CLEAR
 312 0224 1E4B     		ldr	r3, =__zero_table_start__
 313 0226 1F4C     		ldr	r4, =__zero_table_end__
 314              	
 315              	.L_loop2:
 316 0228 A342     		cmp	r3, r4
 317 022a 08DA     		bge	.L_loop2_done
 318 022c 1968     		ldr	r1, [r3]
 319 022e 5A68     		ldr	r2, [r3, #4]
 320 0230 0020     		movs	r0, 0
 321              	
 322              	.L_loop2_0:
 323 0232 043A     		subs	r2, #4
 324 0234 A4BF     		itt	ge
 325 0236 8850     		strge	r0, [r1, r2]
 326 0238 FBE7     		bge	.L_loop2_0
 327              	
 328 023a 0833     		adds	r3, #8
 329 023c F4E7     		b	.L_loop2
 330              	.L_loop2_done:    
 331              	#endif /* __SKIP_BSS_CLEAR */
