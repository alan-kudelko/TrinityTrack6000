prefWatchExpressions=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?>\r\n<watchExpressions>\r\n<expression enabled\="true" text\="i"/>\r\n<expression enabled\="true" text\="rx_data"/>\r\n<expression enabled\="true" text\="(((port-&gt;IN) &gt;&gt; pin) &amp; 0x1U)"/>\r\n<expression enabled\="true" text\="tx_data"/>\r\n<expression enabled\="true" text\="rx_data"/>\r\n<expression enabled\="true" text\="(*((rx_data)+0)@10)"/>\r\n</watchExpressions>\r\n
