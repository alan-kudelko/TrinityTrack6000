 131:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** #if defined(USIC0)
 132:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** #define XMC_I2C0_CH0 XMC_USIC0_CH0                   /**< USIC0 channel 0 base address */
 133:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** #define XMC_I2C0_CH1 XMC_USIC0_CH1                   /**< USIC0 channel 1 base address */
