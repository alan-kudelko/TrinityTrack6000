 105:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** /**
 106:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  * @addtogroup XMClib XMC Peripheral Library
 107:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  * @{
 108:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  */
 109:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** 
 110:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** /**
 111:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  * @addtogroup I2C
 112:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  * @brief Inter Integrated Circuit(IIC) driver for the XMC microcontroller family.
 113:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *
 114:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  * USIC IIC Features: <br>
 115:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *  * Two-wire interface, with one line for shift clock transfer and synchronization (shift clock S
 116:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Communication in standard mode (100 kBit/s) or in fast mode (up to 400 kBit/s) <br>
 117:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Support of 7-bit addressing, as well as 10-bit addressing <br>
 118:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Master mode operation, where the IIC controls the bus transactions and provides the clock sign
 119:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Slave mode operation, where an external master controls the bus transactions and provides the 
 120:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Multi-master mode operation, where several masters can be connected to the bus and bus arbitra
 121:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** 	  The master/slave operation of an IIC bus participant can change from frame to frame. <br>
 122:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Efficient frame handling (low software effort), also allowing DMA transfers <br>
 123:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *	* Powerful interrupt handling due to multitude of indication flags <br>
 124:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  * @{
 125:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  */
 126:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** 
 127:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h **** /*******************************************************************************
 128:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  * MACROS
 129:D:/Projekty/TrinityTrack6000/MainControlBoard/XMC/XMC4200/Libraries/XMCLib/inc\xmc_i2c.h ****  *******************************************************************************/
