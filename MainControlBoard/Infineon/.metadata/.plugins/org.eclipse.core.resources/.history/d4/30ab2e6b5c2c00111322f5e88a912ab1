#include "DAVE.h"                 //Declarations from DAVE Code Generation (includes SFR declaration)
#include "xmc_gpio.h"
#include "xmc_device.h"
#include "xmc_spi.h"

/**

 * @brief main() - Application entry point
 *
 * <b>Details of function</b><br>
 * This routine is the application entry point. It is invoked by the device startup code. It is responsible for
 * invoking the APP initialization dispatcher routine - DAVE_Init() and hosting the place-holder for user application
 * code.
 */

int main(void)
{
  DAVE_STATUS_t status;

  status = DAVE_Init();           /* Initialization of DAVE APPs  */

  if (status != DAVE_STATUS_SUCCESS)
  {
    /* Placeholder for error handler code. The while loop below can be replaced with an user error handler. */
    XMC_DEBUG("DAVE APPs initialization failed\n");

    while(1U)
    {

    }
  }

  // MOSI (input DX0)
  XMC_GPIO_SetMode(XMC_GPIO_PORT0, 0, XMC_GPIO_MODE_INPUT_TRISTATE);

  // SCK (input DX1)
  XMC_GPIO_SetMode(XMC_GPIO_PORT0, 10, XMC_GPIO_MODE_INPUT_TRISTATE);

  // MISO (output DOUT)
  XMC_GPIO_SetMode(XMC_GPIO_PORT0, 1, XMC_GPIO_MODE_OUTPUT_PUSH_PULL_ALT2);

  // CS (hardware slave select)
  XMC_GPIO_SetMode(XMC_GPIO_PORT3, 0, XMC_GPIO_MODE_INPUT_TRISTATE);

  // MOSI → DX0
  XMC_SPI_CH_SetInputSource(SPI_CH,
      XMC_SPI_CH_INPUT_DIN0,
      USIC1_C1_DX0_P0_0);

  // SCK → DX1
  XMC_SPI_CH_SetInputSource(SPI_CH,
      XMC_SPI_CH_INPUT_SCLK,
      USIC1_C1_DX1_P0_10);

  XMC_SPI_CH_CONFIG_t config =
  {
      .baudrate = 1000000, // ignorowane w slave
      .bus_mode = XMC_SPI_CH_BUS_MODE_SLAVE,
      .selo_inversion = XMC_SPI_CH_SLAVE_SEL_INV_TO_MSLS,
      .parity_mode = XMC_USIC_CH_PARITY_MODE_NONE
  };

  XMC_SPI_CH_Init(SPI_CH, &config);

  // przypisanie SELO (CS)
  XMC_SPI_CH_EnableSlaveSelect(SPI_CH, XMC_SPI_CH_SLAVE_SELECT_0);

  // mapping CS → P3.0
  XMC_SPI_CH_SetSlaveSelectInput(SPI_BUS, USIC1_C1_DX2_P3_0);

  while (1)
  {
      while (XMC_USIC_CH_RXFIFO_IsEmpty(SPI_CH));

      uint8_t data = XMC_SPI_CH_GetReceivedData(SPI_CH);

      // echo (debug)
      XMC_SPI_CH_Transmit(SPI_CH, data,);
  }

  /* Placeholder for user application code. The while loop below can be replaced with user application code. */
  XMC_GPIO_SetMode(XMC_GPIO_PORT1,9,XMC_GPIO_MODE_OUTPUT_PUSH_PULL);
  XMC_GPIO_SetOutputHigh(XMC_GPIO_PORT1, 9);

  while(1U)
  {
      for (volatile uint32_t i = 0; i < 1000000; ++i){

      }
      XMC_GPIO_SetOutputLow(XMC_GPIO_PORT1,9);
       for (volatile uint32_t i = 0; i < 1000000; ++i){

       }

       	   XMC_GPIO_SetOutputHigh(XMC_GPIO_PORT1,9);
  }

}
